{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-poc-rewrite/transfer-pilot-v2.schema.json",
  "title": "Real-Issue LLM Text-Transfer Pilot v2",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contextDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "purpose",
        "content_text",
        "content_sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "content_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "study_id",
        "status",
        "created_at_utc",
        "research_question",
        "task_source_policy",
        "cohort",
        "agent_protocol",
        "evaluation",
        "claim_limits"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "study_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "running",
            "complete"
          ]
        },
        "created_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "research_question": {
          "type": "string",
          "minLength": 20
        },
        "task_source_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_snapshot",
            "include_comments",
            "include_repo_checkout",
            "include_web_browsing",
            "prior_public_disclosure_policy"
          ],
          "properties": {
            "source_snapshot": {
              "const": "issue_report_only"
            },
            "include_comments": {
              "const": false
            },
            "include_repo_checkout": {
              "const": false
            },
            "include_web_browsing": {
              "const": false
            },
            "prior_public_disclosure_policy": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "cohort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "target_tasks",
            "selected_tasks",
            "captured_at_utc"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "target_tasks": {
              "type": "integer",
              "minimum": 1
            },
            "selected_tasks": {                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },

            "captured_at_utc": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "agent_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "condition",
            "repetitions",
            "roles",
            "models",
            "system_prompt_sha256",
            "primary_contrast",
            "max_output_tokens_per_call",
            "temperature",
            "max_api_requests",
            "tool_access",
            "comparison_policy",
            "seed_policy"
          ],
          "properties": {
            "condition": {
              "const": "independent_configured_agents"
            },
            "repetitions": {
              "type": "integer",
              "minimum": 1
            },
            "roles": {
              "const": [
                "analyst",
                "extractor",
                "synthesist"
              ]
            },
            "models": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "analyst",
                "extractor",
                "synthesist"
              ],
              "properties": {
                "analyst": {
                  "const": "gemini-3.5-flash-lite"
                },
                "extractor": {
                  "const": "gemma-4-26b-a4b-it"
                },
                "synthesist": {
                  "const": "gemini-3.1-flash-lite"
                }
              }
            },
            "system_prompt_sha256": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "analyst",
                "extractor",
                "synthesist"
              ],
              "properties": {
                "analyst": {
                  "$ref": "#/$defs/sha256"
                },
                "extractor": {
                  "$ref": "#/$defs/sha256"
                },
                "synthesist": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "primary_contrast": {
              "const": "descriptive_role_model_bundle_transfer_only"
            },
            "max_output_tokens_per_call": {
              "const": 512
            },
            "temperature": {
              "const": 0.0
            },
            "max_api_requests": {
              "const": 3
            },
            "tool_access": {
              "const": "prompt_context_only"
            },
            "comparison_policy": {
              "type": "string",
              "minLength": 20
            },
            "seed_policy": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "blinding",
            "raters_per_response",
            "dimensions",
            "no_patch_claim",
            "rating_scale",
            "claims_not_evaluated"
          ],
          "properties": {
            "method": {
              "const": "human_rubric"
            },
            "blinding": {
              "type": "string",
              "minLength": 20
            },
            "raters_per_response": {
              "type": "integer",
              "minimum": 1
            },
            "dimensions": {
              "const": [
                "issue_understanding",
                "evidence_grounding",
                "diagnostic_reasoning",
                "proposed_change_quality",
                "test_strategy",
                "uncertainty_and_scope"
              ]
            },
            "no_patch_claim": {
              "const": true
            },
            "rating_scale": {
              "type": "string",
              "minLength": 20
            },
            "claims_not_evaluated": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "claim_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "issueTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "source",
        "captured_at_utc",
        "task_packet",
        "context",
        "disclosure",
        "eligibility"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[^#]+#[1-9][0-9]*$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "repository",
            "issue_number",
            "issue_family",
            "title",
            "status_at_capture",
            "created_at_utc",
            "updated_at_utc"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[1-9][0-9]*$"
            },
            "repository": {
              "type": "string",
              "pattern": "^[^/]+/[^/]+$"
            },
            "issue_number": {
              "type": "integer",
              "minimum": 1
            },
            "issue_family": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "status_at_capture": {
              "enum": [
                "open",
                "closed"
              ]
            },
            "created_at_utc": {
              "type": "string",
              "format": "date-time"
            },
            "updated_at_utc": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "captured_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "task_packet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "issue_url",
            "issue_text",
            "acceptance_criteria",
            "context_docs",
            "transformation_note",
            "prompt_sha256"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "issue_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[1-9][0-9]*$"
            },
            "issue_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "acceptance_criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "context_docs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contextDoc"
              }
            },
            "transformation_note": {
              "type": "string",
              "minLength": 20
            },
            "prompt_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python_version_reported",
            "package_versions_reported",
            "execution_environment_available",
            "repo_checkout_provided"
          ],
          "properties": {
            "python_version_reported": {
              "type": [
                "string",
                "null"
              ]
            },
            "package_versions_reported": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "execution_environment_available": {
              "const": false
            },
            "repo_checkout_provided": {
              "const": false
            }
          }
        },
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fix_disclosed_in_issue",
            "workaround_disclosed_in_comments",
            "material_causal_hint_in_comments",
            "linked_fix_ref",
            "reviewer_note"
          ],
          "properties": {
            "fix_disclosed_in_issue": {
              "type": "boolean"
            },
            "workaround_disclosed_in_comments": {
              "type": "boolean"
            },
            "material_causal_hint_in_comments": {
              "type": "boolean"
            },
            "linked_fix_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewer_note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reviewers",
            "reason"
          ],
          "properties": {
            "decision": {
              "enum": [
                "pending",
                "include_with_leakage_flag",
                "include",
                "exclude"
              ]
            },
            "reviewers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "model_id",
        "model_version",
        "system_prompt_sha256",
        "prompt_sha256",
        "input_task_ids",
        "output_text",
        "started_at_utc",
        "ended_at_utc",
        "latency_seconds",
        "tokens_in",
        "tokens_out",
        "cost_usd",
        "finish_reason",
        "error_category"
      ],
      "properties": {
        "role": {
          "enum": [
            "analyst",
            "extractor",
            "synthesist"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "system_prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_task_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output_text": {
          "type": "string",
          "maxLength": 20000
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "latency_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tokens_in": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tokens_out": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_category": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "trace_id",
        "task_id",
        "condition",
        "repetition",
        "started_at_utc",
        "ended_at_utc",
        "stages",
        "final_response",
        "final_response_sha256",
        "api_requests",
        "total_latency_seconds",
        "total_tokens_in",
        "total_tokens_out",
        "total_cost_usd",
        "termination_status"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "pattern": "^[^#]+#[1-9][0-9]*$"
        },
        "condition": {
          "const": "independent_configured_agents"
        },
        "repetition": {
          "type": "integer",
          "minimum": 0
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "final_response": {
          "type": "string",
          "maxLength": 20000
        },
        "final_response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "api_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "total_latency_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens_in": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens_out": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "termination_status": {
          "enum": [
            "completed",
            "failed",
            "timeout",
            "cancelled"
          ]
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "rating_id",
        "trace_id",
        "rater_id",
        "blind_id",
        "scores",
        "overall_note",
        "rated_at_utc"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "rating_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "rater_id": {
          "type": "string",
          "minLength": 1
        },
        "blind_id": {
          "type": "string",
          "minLength": 1
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issue_understanding",
            "evidence_grounding",
            "diagnostic_reasoning",
            "proposed_change_quality",
            "test_strategy",
            "uncertainty_and_scope"
          ],
          "properties": {
            "issue_understanding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "evidence_grounding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "diagnostic_reasoning": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "proposed_change_quality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "test_strategy": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "uncertainty_and_scope": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        },
        "overall_note": {
          "type": "string"
        },
        "rated_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/study"
    },
    {
      "$ref": "#/$defs/issueTask"
    },
    {
      "$ref": "#/$defs/trace"
    },
    {
      "$ref": "#/$defs/rubric"
    }
  ]
}

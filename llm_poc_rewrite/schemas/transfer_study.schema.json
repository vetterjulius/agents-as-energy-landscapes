{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-poc-rewrite/transfer-study.schema.json",
  "title": "Legacy Real-Issue Patch-Transfer Study (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "status", "created_at_utc", "aim", "cohort", "conditions", "evaluation", "claim_limits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "study_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "ready", "running", "complete"]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "aim": {"type": "string", "minLength": 20},
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_min", "target_max", "repository", "intake_start", "intake_end"],
      "properties": {
        "target_min": {"type": "integer", "minimum": 1, "maximum": 8},
        "target_max": {"type": "integer", "minimum": 1, "maximum": 8},
        "repository": {"type": ["string", "null"]},
        "intake_start": {"type": ["string", "null"], "format": "date-time"},
        "intake_end": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["baseline", "static_energy", "adaptive_energy"]}
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["primary_contrast", "secondary_contrast", "repetitions", "task_success_requires", "sandbox_required", "api_budget_usd", "worker_skill_routing_claim"],
      "properties": {
        "primary_contrast": {"type": "string", "minLength": 1},
        "secondary_contrast": {"type": "string", "minLength": 1},
        "repetitions": {"type": "integer", "minimum": 1},
        "task_success_requires": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sandbox_required": {"type": "boolean"},
        "api_budget_usd": {"type": ["number", "null"], "minimum": 0},
        "worker_skill_routing_claim": {"const": false}
      }
    },
    "claim_limits": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}

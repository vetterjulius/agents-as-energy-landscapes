{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-poc-rewrite/transfer-data.schema.json",
  "title": "Legacy Real-Issue Patch-Transfer Package Records (v1)",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["pending", "completed", "failed", "timeout", "cancelled"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveInt": {"type": "integer", "minimum": 1},
    "nonNegativeNumber": {"type": ["integer", "number"], "minimum": 0},
    "testResult": {
      "type": "object", "additionalProperties": false,
      "required": ["test_id", "command", "status", "exit_code", "duration_seconds", "log_sha256"],
      "properties": {
        "test_id": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "timeout", "error", "not_run"]},
        "exit_code": {"type": ["integer", "null"]},
        "duration_seconds": {"anyOf": [{"$ref": "#/$defs/nonNegativeNumber"}, {"type": "null"}]},
        "log_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dateTime": {"type": "string", "format": "date-time"},
    "condition": {"enum": ["baseline", "static_energy", "adaptive_energy"]},
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "task_id", "captured_at_utc", "source", "task_packet", "environment", "eligibility"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "task_id": {"type": "string", "minLength": 1},
        "captured_at_utc": {"$ref": "#/$defs/dateTime"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["tracker", "repository", "issue_number", "issue_url", "title", "body_sha256"],
          "properties": {
            "tracker": {"enum": ["github", "gitlab", "bugzilla", "jira", "other"]},
            "repository": {"type": "string", "minLength": 1},
            "issue_number": {"type": "integer", "minimum": 1},
            "issue_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
            "title": {"type": "string", "minLength": 1},
            "body_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "task_packet": {
          "type": "object", "additionalProperties": false,
          "required": ["title", "solver_visible_text", "acceptance_criteria", "prompt_sha256"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "solver_visible_text": {"type": "string", "minLength": 1},
            "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "prompt_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "environment": {
          "type": "object", "additionalProperties": false,
          "required": ["base_commit", "platform", "image_digest", "setup_ref", "test_commands"],
          "properties": {
            "base_commit": {"$ref": "#/$defs/commit"},
            "platform": {"type": "string", "minLength": 1},
            "image_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "setup_ref": {"type": "string", "minLength": 1},
            "test_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "eligibility": {
          "type": "object", "additionalProperties": false,
          "required": ["reviewers", "decision", "exclusion_reason"],
          "properties": {
            "reviewers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "decision": {"enum": ["pending", "included", "excluded"]},
            "exclusion_reason": {"type": ["string", "null"]}
          }
        }
      }
    },
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "task_id", "trusted_fix_ref", "regression_test_ref", "base_result", "fix_result"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "task_id": {"type": "string", "minLength": 1},
        "trusted_fix_ref": {"type": ["string", "null"]},
        "regression_test_ref": {"type": ["string", "null"]},
        "base_result": {"enum": ["not_run", "fail", "pass", "timeout", "error"]},
        "fix_result": {"enum": ["not_run", "fail", "pass", "timeout", "error"]}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "relation_id", "source_task_id", "target_task_id", "relation_type", "tracker_relation", "observed_at_utc", "evidence_url", "rationale", "reviewers", "confidence"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "relation_id": {"type": "string", "minLength": 1},
        "source_task_id": {"type": "string", "minLength": 1},
        "target_task_id": {"type": "string", "minLength": 1},
        "relation_type": {"enum": ["tracker_blocks", "verified_prerequisite", "shared_context", "related_only", "package_dependency"]},
        "tracker_relation": {"type": "string"},
        "observed_at_utc": {
          "type": "object", "additionalProperties": false,
          "required": ["start", "end", "precision"],
          "properties": {
            "start": {"$ref": "#/$defs/dateTime"},
            "end": {"$ref": "#/$defs/dateTime"},
            "precision": {"enum": ["event", "snapshot", "interval"]}
          }
        },
        "evidence_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "rationale": {"type": "string", "minLength": 1},
        "reviewers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "task_id", "condition", "repetition", "model_id", "prompt_sha256", "seed", "started_at_utc", "ended_at_utc", "status", "request_attempts", "patch_sha256", "patch_application", "test_results", "tokens_in", "tokens_out", "cost_usd", "cost_basis", "runtime_seconds", "failure_category"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "run_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "condition": {"$ref": "#/$defs/condition"},
        "repetition": {"type": "integer", "minimum": 0},
        "model_id": {"type": "string", "minLength": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "seed": {"type": "integer"},
        "started_at_utc": {"$ref": "#/$defs/dateTime"},
        "ended_at_utc": {"$ref": "#/$defs/dateTime"},
        "status": {"enum": ["completed", "failed", "timeout", "cancelled"]},
        "request_attempts": {"type": "integer", "minimum": 0},
        "patch_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "patch_application": {"enum": ["applied", "rejected", "not_applicable", "not_run"]},
        "test_results": {"type": "array", "items": {"$ref": "#/$defs/testResult"}},
        "tokens_in": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "tokens_out": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "cost_usd": {"anyOf": [{"$ref": "#/$defs/nonNegativeNumber"}, {"type": "null"}]},
        "cost_basis": {"type": ["string", "null"]},
        "runtime_seconds": {"anyOf": [{"$ref": "#/$defs/nonNegativeNumber"}, {"type": "null"}]},
        "failure_category": {"type": ["string", "null"]}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/issue"},
    {"$ref": "#/$defs/evaluator"},
    {"$ref": "#/$defs/relation"},
    {"$ref": "#/$defs/run"}
  ],
  "$comment": "Legacy record schema for v1 data ledgers. Study metadata is validated by schemas/transfer_study.schema.json."
}
